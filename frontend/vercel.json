{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/docs",
      "destination": "https://swetakararenterprises.mintlify.dev/docs"
    },
    {
      "source": "/docs/:match*",
      "destination": "https://swetakararenterprises.mintlify.dev/docs/:match*"
    }
  ]
}
