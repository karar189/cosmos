{
  "name": "cosmos-frontend",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev:landing": "pnpm --filter @core3/landing-page dev",
    "dev:platform": "pnpm --filter @core3/platform dev",
    "dev:storybook": "pnpm --filter @core3/ui-components storybook",
    "build:landing": "pnpm --filter @core3/landing-page build",
    "build:platform": "pnpm --filter @core3/platform build",
    "build:storybook": "pnpm --filter @core3/ui-components build-storybook",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @core3/landing-page test:e2e",
    "test:platform:e2e": "pnpm --filter @core3/platform test:e2e"
  }
}