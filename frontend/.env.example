# app
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_APP_NAME=

# Mintlify /docs: rewrites live in vercel.json at this folder (edit subdomain if your Mintlify slug changes).
# Local `next dev` does not load vercel.json — use `vercel dev` from this directory, or test /docs on a Vercel Preview/Production URL.
# Absolute URLs for payment links. Leave unset to infer from the browser request (matches http or https dev, e.g. next dev --experimental-https).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# stellar (pay page + Soroban): use "testnet" or "public" (mainnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Payment link destination: set to your POOL address so funds go to the pool (not the business wallet).
# When set, all payment links send XLM here; business "Receive address" is only used for withdraws.
NEXT_PUBLIC_PAYMENT_POOL_ADDRESS=
# Optional: fallback when PAYMENT_POOL_ADDRESS is not set; also used as pool if PAYMENT_POOL_ADDRESS is omitted.
NEXT_PUBLIC_MERCHANT_RECIPIENT=
# Relayer (optional): when set, clients pay the RELAYER; backend forwards to pool so on-chain pool only sees relayer.
NEXT_PUBLIC_RELAYER_PUBLIC_KEY=
RELAYER_SECRET_KEY=

# Soroban contracts — set testnet ID when NEXT_PUBLIC_STELLAR_NETWORK=testnet, mainnet when =public
# Testnet: from soroban-escrow/contracts deploy-testnet.sh
NEXT_PUBLIC_POOLMANAGER_CONTRACT_ID=
# Phase 2: account that submits PoolManager.commit (pays tx fee). Keep secret; use test key for testnet, funded mainnet key for mainnet.
SOROBAN_COMMIT_SOURCE_SECRET=
# optional: server-side contract id override (defaults to NEXT_PUBLIC_POOLMANAGER_CONTRACT_ID)
# POOLMANAGER_CONTRACT_ID=

# clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Compliance checker: generate regulatory checklist. If COSMOS_AI_URL is set, uses Python backend (RegIntel); else uses OPENAI_API_KEY here.
OPENAI_API_KEY=
# Python AI backend (RegIntel, compliance, agent routes). Local: http://localhost:8001. Production (Vercel etc.): your Render URL.
# Example: https://cosmos-ai-s2b0.onrender.com
COSMOS_AI_URL=http://localhost:8001
# Optional: browser-visible base (only if client code must call the API directly). Server routes prefer COSMOS_AI_URL.
# NEXT_PUBLIC_COSMOS_AI_URL=

# Regulatory Intelligence: secret for triggering ingestion (optional; set if you call /api/regintel/ingest/run)
# INGESTION_SECRET=

# Dashboard session signing (challenge + SEP-53 message sign-in). Use a long random secret in production.
AUTH_SECRET=

# database
DATABASE_URL=