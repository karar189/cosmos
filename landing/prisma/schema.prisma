// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  clerkId       String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  links            Link[]
  createdAt        DateTime @default(now())
  subscribed       Boolean  @default(true)
  source           String?
  defaultWorkspace String?

  @@index(source)
  @@index(defaultWorkspace)
}

model Link {
  id         String    @id @default(cuid()) @map("_id")
  domain     String
  key        String
  url        String
  expiresAt  DateTime?
  expiredUrl String?
  password   String?
  externalId String?

  proxy       Boolean @default(false)
  title       String?
  description String?
  image       String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  publicStats Boolean   @default(false)
  clicks      Int       @default(0)
  lastClicked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags LinkTag[]
}

model LinkTag {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  color     String   @default("blue")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projectId String
  Link      Link?    @relation(fields: [linkId], references: [id])
  linkId    String?

  @@unique([name, projectId])
  @@index(projectId)
}

// Phase 1: business identity + payment links with attribution (pool + memo)
model Business {
  id              String    @id @default(cuid()) @map("_id")
  walletAddress   String    @unique // Stellar G... address from Freighter
  receiveAddress  String?   // Stellar G... where this business receives payments (user-set)
  createdAt       DateTime  @default(now())
  paymentLinks    PaymentLink[]
  withdrawals     Withdrawal[]
}

model PaymentLink {
  id                 String    @id @default(cuid()) @map("_id")
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount             String
  purpose            String?   // e.g. "Invoice", "Deposit"
  clientName         String?
  workflowStage      String?   // e.g. "pending", "signed", "delivered"
  linkMemo           String    @unique // unique memo for attribution when client pays to pool
  destinationAddress String    // pool address (from env when created)
  paidAt             DateTime?
  paymentTxHash      String?
  // Phase 2: ZK commitment (payment → commit on-chain)
  payerAddress       String?   // Stellar G... who paid (from tx source)
  nonce              String?   // random nonce used to derive nullifier
  nullifier          String?   // stored for withdraw (mark spent)
  commitmentTxHash   String?   // Soroban tx that added the commitment
  createdAt          DateTime  @default(now())

  @@index(businessId)
  @@index([businessId, paidAt])
}

// Phase 4: Withdrawals — track used nullifiers and payouts from pool
model Withdrawal {
  id               String    @id @default(cuid()) @map("_id")
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  amount           String    // XLM amount withdrawn
  nullifiers       String[]  // nullifiers marked as spent (from PaymentLinks)
  recipientAddress String    // Stellar G... where funds were sent
  status           String    // "pending" | "completed" | "failed"
  payoutTxHash     String?   // Stellar tx that sent funds from pool to recipient
  contractTxHash   String?   // Soroban withdraw tx (if contract marks nullifiers)
  createdAt        DateTime  @default(now())

  @@index(businessId)
}
