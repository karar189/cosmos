# app
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# stellar (pay page: testnet or public)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Payment link destination: set to your POOL address so funds go to the pool (not the business wallet).
# When set, all payment links send XLM here; business "Receive address" is only used for withdraws.
NEXT_PUBLIC_PAYMENT_POOL_ADDRESS=
# Optional: fallback when PAYMENT_POOL_ADDRESS is not set; also used as pool if PAYMENT_POOL_ADDRESS is omitted.
NEXT_PUBLIC_MERCHANT_RECIPIENT=
# Relayer (optional): when set, clients pay the RELAYER; backend forwards to pool so on-chain pool only sees relayer.
NEXT_PUBLIC_RELAYER_PUBLIC_KEY=
RELAYER_SECRET_KEY=

# deployed Soroban contracts (testnet) — from soroban-escrow/contracts deploy-testnet.sh
NEXT_PUBLIC_ESCROW_ENGINE_CONTRACT_ID=
NEXT_PUBLIC_POOLMANAGER_CONTRACT_ID=
# Phase 2: account that submits PoolManager.commit (pays tx fee). Keep secret; use test key for dev.
SOROBAN_COMMIT_SOURCE_SECRET=
# optional: server-side contract id override (defaults to NEXT_PUBLIC_POOLMANAGER_CONTRACT_ID)
# POOLMANAGER_CONTRACT_ID=

# clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# database
DATABASE_URL=