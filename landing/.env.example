# app
NEXT_PUBLIC_APP_DOMAIN=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# stellar (pay page + Soroban): use "testnet" or "public" (mainnet)
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Payment link destination: set to your POOL address so funds go to the pool (not the business wallet).
# When set, all payment links send XLM here; business "Receive address" is only used for withdraws.
NEXT_PUBLIC_PAYMENT_POOL_ADDRESS=
# Optional: fallback when PAYMENT_POOL_ADDRESS is not set; also used as pool if PAYMENT_POOL_ADDRESS is omitted.
NEXT_PUBLIC_MERCHANT_RECIPIENT=
# Relayer (optional): when set, clients pay the RELAYER; backend forwards to pool so on-chain pool only sees relayer.
NEXT_PUBLIC_RELAYER_PUBLIC_KEY=
RELAYER_SECRET_KEY=

# Soroban contracts — set testnet IDs when NEXT_PUBLIC_STELLAR_NETWORK=testnet, mainnet when =public
# Testnet: from soroban-escrow/contracts deploy-testnet.sh
# Mainnet examples (StellarExpert): PoolManager CAN2RE5SDLJ67G5RSGUDB4BYNUZ3QMPGJOLPUWRVOTMLAWVA3UO4PBV2, Escrow CDBYDNW3MLBFYALZ2WBJ5KWJLCPFW556XKHLV7BVT5YNBU7WPN2JDXDS
NEXT_PUBLIC_ESCROW_ENGINE_CONTRACT_ID=
NEXT_PUBLIC_POOLMANAGER_CONTRACT_ID=
# Phase 2: account that submits PoolManager.commit (pays tx fee). Keep secret; use test key for testnet, funded mainnet key for mainnet.
SOROBAN_COMMIT_SOURCE_SECRET=
# optional: server-side contract id override (defaults to NEXT_PUBLIC_POOLMANAGER_CONTRACT_ID)
# POOLMANAGER_CONTRACT_ID=

# clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Compliance checker: generate regulatory checklist via OpenAI (optional)
OPENAI_API_KEY=

# Cosmos AI backend (Onboarding / Compliance Maker widget recommendations). Default: http://localhost:8001
COSMOS_AI_URL=http://localhost:8001

# database
DATABASE_URL=